        ],
        "replay": [
          "SkillFxPresenter"
        ]
      },
      "accepted": {}
    },
    {
      "id": "cast_windup_anim",
      "name": "施法起手动作时序",
      "target": [
        "host",
        "net",
        "replay"
      ],
      "patterns": {
        "host": [
          "ACT_CAST"
        ],
        "net": [
          "ACT_CAST"
        ],
        "replay": [
          "_play_cast_anim"
        ]
      },
      "accepted": {}
    }
  ]
}
