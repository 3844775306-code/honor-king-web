{
  "meta": {
    "desc": "三端 UI 功能对齐基线：feature->各端识别正则。patterns 命中任意一个即视为该端具备此 UI。accepted 里的端表示设计性差异（不算缺口）。",
    "sides": {
      "host": [
        "scripts/ui",
        "scripts/mobile",
        "scripts/core/BattleManager.gd",
        "scripts/core/ChatService.gd",
        "scripts/ui/shared"
      ],
      "net": [
        "scripts/net",
        "scripts/core/ChatService.gd",
        "scripts/ui/shared"
      ],
      "replay": [
        "scripts/replay",
        "scripts/ui/shared"
      ]
    }
  },
