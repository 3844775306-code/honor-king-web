; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="HonorKing"
run/main_scene="res://scenes/lobby.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Config="*res://scripts/core/Config.gd"
UiKit="*res://scripts/ui/UiKit.gd"
ItemDatabase="*res://assets/ItemDatabase.gd"
SkillDatabase="*res://assets/SkillDataBase.gd"
GameManager="*res://scripts/core/GameManager.gd"
UiManager="*res://scripts/ui/UI_Manager.gd"
CollisionSystem="*res://scripts/core/CollisionSystem.gd"
PathFinder="*res://scripts/core/PathFinder.gd"
TouchController="*res://scripts/mobile/TouchController.gd"
NetSession="*res://scripts/net/NetSession.gd"
ChatService="*res://scripts/core/ChatService.gd"
SfxManager="*res://scripts/core/SfxManager.gd"
Vfx="*res://scripts/core/VfxFactory.gd"
PostFX="*res://scripts/core/PostFX.gd"

[display]

window/size/viewport_width=2400
window/size/viewport_height=1400
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=2

