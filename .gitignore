# Godot 4+ specific ignores
.godot/

# 构建 / 发布产物（体积大，不入库）
web/
android/
build/
export/
artifacts/
.cache/
.tmp/
screenshots/
*.apk
*.apk.idsig
*.pck
*.exe
*.console.exe
*.idsig
*.TMP
*.tmp

# 本地临时调试脚本
_probe_hitch.*

# 本地大模型聊天配置（含 API key，不要提交）
ai_chat.cfg

# 灵宝本地存档（user:// 不可写时的兜底）
lingbao.cfg

# 录像（P1 本地录制；沙箱环境会退到工程目录）
replays/
*.rep

# 录像导出（分享副本）
exports/

# 根目录导出/调试残留（发布产物统一放 build/）
HonorKing.*
*.log
*.err
*.out

# 本地工具二进制
tools/bin/

# Office 临时锁文件
~\$*

# 英雄统计采样数据（本地生成）
data/hero_stats/*.csv
data/hero_stats/*.xlsx

# 伤害审计表格（本地生成）
data/damage_audit/*.csv
data/damage_audit/*.log
